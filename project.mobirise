      "settings": {
        "main": true,
        "title": "Marvel - ass2",
        "meta_descr": "Marvel Cinematic Universe (MCU) is a popular film series featuring superheroes and connected storylines. It combines action, storytelling, and strong visual techniques.\n\nThis page focuses on film composition in Marvel movies, such as symmetrical composition, top shot, leading lines, and low angle shots, showing how these techniques enhance storytelling and visual impact.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/2026-04-08-8.44.01.png"
